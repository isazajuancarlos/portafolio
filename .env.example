# Copia este archivo a .env y rellena los valores. NUNCA subas el .env real.

# --- Secretos (obligatorios en producción) ---
APP_SECRET=            # cifra las sesiones. Genera uno: python -c "import secrets;print(secrets.token_hex(32))"
ADMIN_PASSWORD=        # clave del panel admin. Sin ella, el admin queda deshabilitado.
PASSWORD=              # contraseña SMTP de Zoho (contacto@xiliux.com)

# --- SEO / Analytics (opcional, recomendado) ---
GOOGLE_ANALYTICS_ID=              # G-XXXXXXXXXX
GOOGLE_SEARCH_CONSOLE_VERIFICATION=

# --- Ventas / Contacto (cada CTA aparece SOLO si su valor está definido) ---
CONTACT_EMAIL=contacto@xiliux.com
WHATSAPP_NUMBER=       # formato internacional sin '+', ej: 34600111222 -> activa el botón flotante de WhatsApp
BOOKING_URL=           # Calendly / Cal.com, ej: https://cal.com/xiliux -> botón "Agendar llamada"

# --- Pagos self-serve (Stripe Payment Links; opcional) ---
# Si defines el enlace, la tarjeta de ese servicio muestra un botón "Reservar".
STRIPE_MVP=            # https://buy.stripe.com/...  (Desarrollo de MVP)
STRIPE_IA=             # https://buy.stripe.com/...  (Integración de IA)
STRIPE_SCRIPT=         # https://buy.stripe.com/...  (Scripts y Bots)

# --- Venta del servicio Quipu OPRF (suscripción PayPal + aprovisionamiento) ---
# Los planes de /quipu/precios muestran botones de pago SOLO si PayPal + OPRF están
# configurados; si no, muestran "Próximamente". Ver quipu_sales.py y paypal_setup.py.
PAYPAL_ENV=sandbox          # sandbox | live
PAYPAL_CLIENT_ID=           # de tu app en developer.paypal.com
PAYPAL_SECRET=              # secret de esa misma app
PAYPAL_WEBHOOK_ID=          # ID del webhook que apunta a https://xiliux.com/paypal/webhook
# Plan IDs (P-XXXX) que imprime `python paypal_setup.py` tras crearlos:
PAYPAL_PLAN_BETA=
PAYPAL_PLAN_STARTER=
PAYPAL_PLAN_PRO=
# Conexión al quipu-oprf-server desplegado en tu VPS:
OPRF_SERVER_URL=            # ej: https://oprf.xiliux.com   (o http://127.0.0.1:8787 si mismo host)
OPRF_ADMIN_TOKEN=           # el QUIPU_OPRF_ADMIN_TOKEN del servidor
